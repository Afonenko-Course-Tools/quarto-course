{
  "name": "quarto-course-tests",
  "private": true,
  "scripts": {
    "test:browser": "node tests/navigation.browser.cjs && node tests/presentation/browser.cjs && node tests/presentation/unified.browser.cjs && node tests/release-localization.cjs",
    "test:navigation-model": "node --test tests/navigation-model.cjs",
    "test:dependencies": "depcruise --config .dependency-cruiser.json --output-type err-long _extensions/course-core _extensions/course-navigation",
    "test:types": "quarto run tests/navigation-typecheck.ts",
    "test:types:javascript": "tsc --project typecheck/javascript.json",
    "test:types:python": "pyright --project pyrightconfig.json",
    "test:types:lua": "quarto run tools/check-lua.ts",
    "test:types:shell": "python3 tools/check-static.py",
    "test:types:all": "npm run test:types && npm run test:types:javascript && npm run test:types:python && npm run test:types:lua && npm run test:types:shell",
    "test": "bash tools/check-canonical.sh --native",
    "test:quick": "bash tools/check-canonical.sh --quick",
    "check-quality": "node tools/check-quality.mjs",
    "check-quality:controls": "node tools/check-quality-controls.mjs",
    "check:static": "python3 tools/check-static.py",
    "format": "python3 tools/check-static.py --write",
    "check:static:controls": "python3 tools/check-static-controls.py"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "dependency-cruiser": "18.7.2",
    "eslint": "^10.14.0",
    "html-validate": "^11.21.1",
    "playwright": "1.64.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.10.1",
    "pyright": "1.1.414",
    "stylelint": "^18.0.0",
    "stylelint-scss": "^7.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "eslint": {
      "minimatch": "^11.0.8"
    }
  }
}
