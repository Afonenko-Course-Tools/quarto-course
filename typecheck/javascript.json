{
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "browser.d.ts",
    "../_extensions/course-core/**/*.js",
    "../_extensions/course-core/**/*.cjs",
    "../_extensions/course-core/**/*.mjs",
    "../_extensions/course-navigation/**/*.js",
    "../_extensions/course-navigation/**/*.cjs",
    "../_extensions/course-navigation/**/*.mjs",
    "../_extensions/course-presentation/**/*.js",
    "../_extensions/course-presentation/**/*.cjs",
    "../_extensions/course-presentation/**/*.mjs",
    "../_extensions/course-theme/**/*.js",
    "../_extensions/course-theme/**/*.cjs",
    "../_extensions/course-theme/**/*.mjs",
    "../tests/**/*.js",
    "../tests/**/*.cjs",
    "../tests/**/*.mjs",
    "../tools/**/*.js",
    "../tools/**/*.cjs",
    "../tools/**/*.mjs",
    "../eslint.config.mjs"
  ],
  "exclude": ["../**/vendor/**", "../tests/fixtures/sources/**"]
}
