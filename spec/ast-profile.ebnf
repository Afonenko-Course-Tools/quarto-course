(* type: specification; component: course-core; status: current; version: 4.0.0 *)
(* Quarto/Pandoc разбирает Markdown. Здесь форма фактического AST, не парсер. *)
Course             = SelectedDocument, { SelectedDocument } ;
SelectedDocument   = { BodyBlock | BankExercise | TaskItems | ProfileContent } ;
BankExercise       = Div(exr_id, own_difficulty, own_time, effective_statement_visibility,
                          [target], [project], [activity_role], { BodyBlock | GradingNotes }) ;
NativeExample      = Div(exm_id, { BodyBlock }) ;
NamedBankSolution  = Div(sol_same_suffix, { BodyBlock }) ;
NestedBankSolution = Div(class_solution, { BodyBlock }) ;
GradingNotes       = Div(class_grading_notes, { BodyBlock }) ;
ProfileContent     = (Div | Span | CodeBlock)(native_profile_condition, content) ;
TaskItems          = Div(class_task_items, [stage], List(TaskReference, { TaskReference })) ;
TaskReference      = Cite(exr_id) | Span([requirement], [work_mode], Cite(exr_id)) ;
requirement        = "required" | "optional" ;
work_mode          = "individual" | "pair" | "group" ;
stage              = "demonstration" | "classroom" | "homework" ;
assessment_kind    = "lab" | "seminar" | "practical" | "test" ;
statement_visibility = "open" | "restricted" ;
PedagogicalElement = Div([native_id], [course_role], [for_activity],
                         [difficulty], [time_minutes], [work_mode],
                         [reading_requirement], { BodyBlock }) ;

(* BankExercise требует effective exercise-bank:true, положительное целое own_time,
   обязательную difficulty и эффективную visibility атрибута/native metadata.
   Native exr/exm/sol вне банка сохраняют Quarto и не требуют этих полей.
   В одном QMD одна работа; несколько TaskItems объединяются в порядке документа.
   Stage необязателен; Span defaults required/individual; повтор member запрещён.
   NamedBankSolution совпадает suffix с exr того же QMD; анонимное решение вложено.
   Одно решение на задачу; solution for внутри банка не поддерживается.
   AssessmentPreview не объявляет состав и исключается из selected export.
   Нормативная семантика: learning-elements.md и visibility.md. *)
