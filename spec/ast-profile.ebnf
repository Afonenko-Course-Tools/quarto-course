(* Грамматика узлов Pandoc. Разбор символов Markdown выполняет сам Pandoc.
   Терминалы BodyBlock и Inline определены Pandoc и здесь не дублируются.
   Смысловые ограничения проверяются core.cue и схемами адаптеров. *)
Course          = SelectedDocument, { SelectedDocument } ;
SelectedDocument = { BodyBlock | Exercise | AssessmentMembers | ProfileContent } ;
ProfileContent  = (Div | Span | CodeBlock)(profile_condition, content) ;
GradingNotes    = Div(class_grading_notes, { BodyBlock }) ;
Exercise        = Div(target, exr_id, [project],
                      Header(level, title), { BodyBlock | GradingNotes }) ;
PedagogicalElement = Div([native_id], [course_role], [for_exercise],
                         [difficulty], [time_minutes], [work_mode],
                         [reading_requirement], { BodyBlock }) ;
AssessmentMembers = Div(class_assessment_items,
                         List(ExerciseReference, { ExerciseReference })) ;
ExerciseReference = Cite(exr_id) ;
Source          = InlineProgram(language, text) | FileProgram(language, path) ;

(* target выбирает ручную проверку или зарегистрированный адаптер.
   Quarto раскрывает включения до проверки этой структуры узлов.
   EBNF поясняет форму AST; исполняемую проверку выполняют сборщики фактов и CUE. *)

(* Условия профиля применяются до извлечения фактов.
   .when-<profile> / .unless-<profile> — краткая запись условий профиля.
   Штатные условия Quarto эквивалентны; смешение двух записей недопустимо.
   GradingNotes относятся к одному Exercise; full сохраняет их в отдельном поле AST.
   Согласованность представлений и контракт адаптеров описаны в visibility.md. *)

(* PedagogicalElement описывает текущий учебный контракт, см. learning-elements.md.
   Штатные упражнения без target являются учебными элементами без оценивания.
   Ссылки внутри prerequisites/reading сохраняют структуру Pandoc/Quarto.
   Фильтр представления использует авторские атрибуты после извлечения ядром. *)
