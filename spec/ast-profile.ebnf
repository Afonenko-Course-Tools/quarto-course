(* type: specification; component: course-core; status: current *)
(* Quarto/Pandoc разбирает Markdown. EBNF описывает извлечённую форму AST,
   не заменяет штатный парсер, ссылки и форматирование. *)
Course            = SelectedDocument, { SelectedDocument } ;
SelectedDocument  = { BodyBlock | Exercise | TaskItems | ProfileContent } ;
Exercise          = Div(exr_id, [target], [project], [course_role],
                         [difficulty], { BodyBlock | GradingNotes }) ;
Example           = Div(exm_id, { BodyBlock }) ;
Solution          = Div(sol_id, [for_activity], { BodyBlock }) ;
GradingNotes      = Div(class_grading_notes, { BodyBlock }) ;
ProfileContent    = (Div | Span | CodeBlock)(native_profile_condition, content) ;
TaskItems         = Div(class_task_items, List(TaskReference, { TaskReference })) ;
TaskReference     = Cite(exr_id) | Span(requirement, Cite(exr_id)) ;
requirement       = "required" | "optional" ;
PedagogicalElement = Div([native_id], [course_role], [for_activity],
                          [difficulty], [time_minutes], [work_mode],
                          [reading_requirement], { BodyBlock }) ;

(* exr/exm/sol не требуют course.id, target, метаданных или sec-* владельца.
   Явный target требует ведущий Header и выбирает зарегистрированного адаптера.
   Один task-items задаёт местный состав работы; метаданные assessment необязательны.
   Штатные условия профиля: content-visible/content-hidden +
   when-profile/unless-profile. Формат/метаданные обрабатывает Quarto.
   Нормативные семантические правила: learning-elements.md и visibility.md. *)
